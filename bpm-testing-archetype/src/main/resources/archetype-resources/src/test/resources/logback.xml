<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <logger name="org.finos.fluxnova.bpm.engine" level="WARN"/>
  <logger name="org.finos.fluxnova.bpm.engine.persistence" level="WARN"/>
  <logger name="Logger" level="INFO"/>

  <root level="WARN">
    <appender-ref ref="STDOUT" />
  </root>
</configuration>
