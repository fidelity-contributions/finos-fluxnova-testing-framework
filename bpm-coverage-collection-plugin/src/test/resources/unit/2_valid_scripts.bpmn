var j = 1+1;

ContinueStatement(5);

function ContinueStatement(input) {
  let i = 0;
  while (i &lt; 10) {
    if (i === input) {
      i++;
      continue;
    }
    console.log(i);
    i++;
  }
}</bpmn:script>
