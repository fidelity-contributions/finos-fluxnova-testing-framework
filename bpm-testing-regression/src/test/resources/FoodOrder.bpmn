<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://fluxnova.finos.org/schema/modeler/1.0" id="Definitions_18ujp9m" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Fluxnova Modeler" exporterVersion="1.1.1" modeler:executionPlatform="Fluxnova Platform" modeler:executionPlatformVersion="1.0.0" xmlns:fluxnova="http://fluxnova.finos.org/schema/1.0/bpmn">
  <bpmn:process id="PizzaOrderProcessKey" name="PizzaOrder" isExecutable="true" camunda:historyTimeToLive="30">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:extensionElements />
      <bpmn:outgoing>Flow_1crcoqw</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1crcoqw" sourceRef="StartEvent_1" targetRef="GetFamilyMember" />
    <bpmn:scriptTask id="GetFamilyMember" name="Get family member" scriptFormat="groovy">
      <bpmn:incoming>Flow_1crcoqw</bpmn:incoming>
      <bpmn:outgoing>Flow_1bvm2c7</bpmn:outgoing>
      <bpmn:script>def firstName = execution.getVariable("firstName");
def isWeekend = execution.getVariable("isWeekend");

def isVegan = false;

if (firstName.equals("John")) {
    isVegan = true;
} else if (firstName.equals("Sam")) {
    isVegan = false;
}

if (!isVegan &amp;&amp; isWeekend) {
    execution.setVariable("restaurant", "Pizza Hut")
} else {
    execution.setVariable("restaurant", "Chopped")
}

execution.setVariable("isVegan", isVegan);</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_1bvm2c7" sourceRef="GetFamilyMember" targetRef="Activity_0ohzg6o" />
    <bpmn:serviceTask id="Activity_0ohzg6o" name="Initiate Order" camunda:class="org.finos.fluxnova.bpm.test.example.delegates.ExampleOneDelegate">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="restaurantName">${restaurant}</camunda:inputParameter>
          <camunda:outputParameter name="websiteUrl">${websiteUrl}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1bvm2c7</bpmn:incoming>
      <bpmn:outgoing>Flow_04ilxn8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_1g1lek6" default="Flow_0w7usl0">
      <bpmn:incoming>Flow_04ilxn8</bpmn:incoming>
      <bpmn:outgoing>Flow_0hqafzy</bpmn:outgoing>
      <bpmn:outgoing>Flow_0w7usl0</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_0zs26r7">
      <bpmn:extensionElements>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="js">execution.setVariable("result", "success")</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_19j7kgg</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0hqafzy" sourceRef="Gateway_1g1lek6" targetRef="VeganMenuCA">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${isVegan == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0w7usl0" sourceRef="Gateway_1g1lek6" targetRef="StandardMenuCA" />
    <bpmn:sequenceFlow id="Flow_11m6t91" sourceRef="VeganMenuCA" targetRef="Activity_15hfvyw" />
    <bpmn:sequenceFlow id="Flow_0e3iauv" sourceRef="StandardMenuCA" targetRef="Activity_15hfvyw" />
    <bpmn:sequenceFlow id="Flow_19j7kgg" sourceRef="Activity_15hfvyw" targetRef="Event_0zs26r7" />
    <bpmn:sequenceFlow id="Flow_04ilxn8" sourceRef="Activity_0ohzg6o" targetRef="Gateway_1g1lek6" />
    <bpmn:endEvent id="Event_0cencs7">
      <bpmn:extensionElements>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="groovy" resource="error-logger.groovy" />
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_118pl26</bpmn:incoming>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_0hrefbj" errorRef="Error_0l4z2zp" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_118pl26" sourceRef="Event_1ummo94" targetRef="Event_0cencs7" />
    <bpmn:boundaryEvent id="Event_1ummo94" name="Initiate_Order_Error" attachedToRef="Activity_0ohzg6o">
      <bpmn:outgoing>Flow_118pl26</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_0w30ql7" errorRef="Error_0l4z2zp" />
    </bpmn:boundaryEvent>
    <bpmn:callActivity id="StandardMenuCA" name="Standard Menu" calledElement="StandardMenuProcess">
      <bpmn:extensionElements>
        <camunda:in source="websiteUrl" target="websiteUrl" />
        <camunda:out source="menu" target="menu" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0w7usl0</bpmn:incoming>
      <bpmn:outgoing>Flow_0e3iauv</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="VeganMenuCA" name="Vegan Menu" calledElement="VeganMenuProcess">
      <bpmn:extensionElements>
        <camunda:in source="websiteUrl" target="websiteUrl" />
        <camunda:out source="menu" target="menu" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0hqafzy</bpmn:incoming>
      <bpmn:outgoing>Flow_11m6t91</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:scriptTask id="Activity_15hfvyw" name="Order" scriptFormat="javascript" camunda:resource="order-details.js">
      <bpmn:incoming>Flow_11m6t91</bpmn:incoming>
      <bpmn:incoming>Flow_0e3iauv</bpmn:incoming>
      <bpmn:outgoing>Flow_19j7kgg</bpmn:outgoing>
    </bpmn:scriptTask>
  </bpmn:process>
