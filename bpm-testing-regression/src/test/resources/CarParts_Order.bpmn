<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://fluxnova.finos.org/schema/modeler/1.0" xmlns:fluxnova="http://fluxnova.finos.org/schema/1.0/bpmn" id="Definitions_0n9dcd9" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Fluxnova Modeler" exporterVersion="1.1.1" modeler:executionPlatform="Fluxnova Platform" modeler:executionPlatformVersion="1.0.0">
  <bpmn:process id="CarPartsOrderProcessKey" name="CarPartsOrder" isExecutable="true" camunda:historyTimeToLive="30">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_11ud344</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1yxsixk" sourceRef="GoToPartSearch" targetRef="Activity_1sosy45" />
    <bpmn:serviceTask id="Lookup_Car_Make_Model" name="Lookup Car Make/Model (Http Connector)">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="header">
              <camunda:map>
                <camunda:entry key="Acccept">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:inputParameter name="method">GET</camunda:inputParameter>
            <camunda:inputParameter name="url">http://localhost:8080/car-registration/${carRegistration}</camunda:inputParameter>
            <camunda:outputParameter name="carLookupStatusCode">${statusCode}</camunda:outputParameter>
            <camunda:outputParameter name="carMakeModel">${response}</camunda:outputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0e7c7co</bpmn:incoming>
      <bpmn:outgoing>Flow_0f22wta</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0e7c7co" sourceRef="Activity_05tg1gr" targetRef="Lookup_Car_Make_Model" />
    <bpmn:exclusiveGateway id="Gateway_0k56o7c" default="Flow_02l3isc">
      <bpmn:extensionElements />
      <bpmn:incoming>Flow_0f22wta</bpmn:incoming>
      <bpmn:outgoing>Flow_02l3isc</bpmn:outgoing>
      <bpmn:outgoing>Flow_1la201r</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0f22wta" sourceRef="Lookup_Car_Make_Model" targetRef="Gateway_0k56o7c" />
    <bpmn:sequenceFlow id="Flow_02l3isc" sourceRef="Gateway_0k56o7c" targetRef="Activity_1s12wj6" />
    <bpmn:sequenceFlow id="Flow_1la201r" sourceRef="Gateway_0k56o7c" targetRef="Activity_1cp3w2e">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${isVintage == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:scriptTask id="Activity_1cp3w2e" name="Vintage Car" scriptFormat="groovy" camunda:resource="car-lookup.groovy">
      <bpmn:incoming>Flow_1la201r</bpmn:incoming>
      <bpmn:outgoing>Flow_0v262as</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Activity_1s12wj6" name="Regular Car" scriptFormat="groovy" camunda:resource="car-lookup.groovy">
      <bpmn:incoming>Flow_02l3isc</bpmn:incoming>
      <bpmn:outgoing>Flow_18fzzym</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_18fzzym" sourceRef="Activity_1s12wj6" targetRef="Activity_0r5uy0n" />
    <bpmn:sequenceFlow id="Flow_0v262as" sourceRef="Activity_1cp3w2e" targetRef="Activity_17jpph3" />
    <bpmn:sequenceFlow id="Flow_11ud344" sourceRef="StartEvent_1" targetRef="GoToPartSearch" />
    <bpmn:scriptTask id="GoToPartSearch" name="Go To Part Search" scriptFormat="groovy">
      <bpmn:incoming>Flow_11ud344</bpmn:incoming>
      <bpmn:outgoing>Flow_1yxsixk</bpmn:outgoing>
      <bpmn:script>def partsSearchUrl = "https://carparts.com";
def isVintage = false;
def carAge = execution.getVariable("carAge");

if (carAge &gt; 30) {
    isVintage = true;
    partsSearchUrl = "https://vintagecarparts.com";
}

execution.setVariable("searchUrl", partsSearchUrl);
execution.setVariable("isVintage", isVintage);
</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="Activity_05tg1gr" name="Capture Car Registration" camunda:class="org.finos.fluxnova.bpm.test.example.delegates.CarPartsDelegate">
      <bpmn:incoming>Flow_0iegivu</bpmn:incoming>
      <bpmn:outgoing>Flow_0e7c7co</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:subProcess id="Activity_1kfqh89" triggeredByEvent="true">
      <bpmn:scriptTask id="ExceptionHandling" name="ExceptionHandling" scriptFormat="groovy">
        <bpmn:incoming>Flow_1y7cyjq</bpmn:incoming>
        <bpmn:outgoing>Flow_04drzxx</bpmn:outgoing>
        <bpmn:script>execution.setVariable("result", "fail");
</bpmn:script>
      </bpmn:scriptTask>
      <bpmn:endEvent id="Event_1tgkh65" name="ErrorEnd">
        <bpmn:extensionElements />
        <bpmn:incoming>Flow_04drzxx</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_1y7cyjq" sourceRef="ErrorStart" targetRef="ExceptionHandling" />
      <bpmn:sequenceFlow id="Flow_04drzxx" sourceRef="ExceptionHandling" targetRef="Event_1tgkh65" />
      <bpmn:startEvent id="ErrorStart" name="ErrorStart">
        <bpmn:outgoing>Flow_1y7cyjq</bpmn:outgoing>
        <bpmn:errorEventDefinition id="ErrorEventDefinition_01thbgy" />
      </bpmn:startEvent>
    </bpmn:subProcess>
    <bpmn:endEvent id="Vintage_PartOrder_End" name="Vintage_PartOrder_End">
      <bpmn:incoming>Flow_1rl1uqo</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1rl1uqo" sourceRef="Activity_17jpph3" targetRef="Vintage_PartOrder_End" />
    <bpmn:endEvent id="Regular_PartOrder_End" name="Regular_PartOrder_End">
      <bpmn:incoming>Flow_13il8vy</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_13il8vy" sourceRef="Activity_0r5uy0n" targetRef="Regular_PartOrder_End" />
    <bpmn:userTask id="Activity_1sosy45" name="Input Car Registration">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="carRegistration">261D1234</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1yxsixk</bpmn:incoming>
      <bpmn:outgoing>Flow_0iegivu</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_0iegivu" sourceRef="Activity_1sosy45" targetRef="Activity_05tg1gr" />
    <bpmn:callActivity id="Activity_0r5uy0n" name="Order Regular Part" calledElement="OrderRegularPartProcess">
      <bpmn:incoming>Flow_18fzzym</bpmn:incoming>
      <bpmn:outgoing>Flow_13il8vy</bpmn:outgoing>
